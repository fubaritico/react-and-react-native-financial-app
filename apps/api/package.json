{
  "name": "api-financial-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "generate:spec": "tsx --env-file=.env src/lib/generate-spec.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@financial-app/prisma": "workspace:^",
    "@sentry/node": "^10.54.0",
    "@supabase/supabase-js": "catalog:",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "serverless-http": "^4.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "msw": "^2.14.6",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "type-fest": "^5.6.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
