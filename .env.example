# Supabase Configuration
# See docs/modus-operandi/supabase-setup.md for the full setup guide.
# Get these values from: Project Settings > API in the Supabase dashboard.

# Project URL (public)
SUPABASE_URL=https://your-project-id.supabase.co

# Anon Key (public - safe to expose in client apps)
SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (PRIVATE - server-side only, used by apps/api/)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dev Seed — test user credentials (used by `pnpm seed`)
# Choose any email/password — the seed script will create this user automatically.
# Password must satisfy the front-end validation rules (16+ chars, upper, lower, digit, special).
SEED_EMAIL=
SEED_PASSWORD=
