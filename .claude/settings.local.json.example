{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash",
      "Skill(simplify)",
      "Skill(loop)",
      "Skill(claude-api)",
      "Skill(find-skills)",
      "Skill(supabase-postgres-best-practices)",
      "Skill(supabase)",
      "Skill(commit)",
      "Skill(note)",
      "Skill(setup-tokens-package)",
      "Skill(restart-session)",
      "Skill(monorepo-check)",
      "Skill(vendor-expo-building-native-ui)",
      "Skill(web-design-guidelines)",
      "Skill(new-component)",
      "Skill(end-session)",
      "Skill(vendor-callstack-rn-best-practices)",
      "Skill(migrate-to-nativewind-v5)",
      "Skill(build-tokens)",
      "Skill(vendor-expo-upgrading-expo)",
      "Skill(create-skill)",
      "Skill(vendor-expo-native-data-fetching)",
      "Skill(composition-patterns)",
      "Skill(cross-platform-component)",
      "Skill(review)",
      "Skill(audit-owasp)",
      "Skill(react-best-practices)",
      "Skill(api-openapi)",
      "Skill(react-view-transitions)",
      "Skill(react-native-skills)",
      "Skill(add-package)",
      "Skill(expo-build)",
      "Skill(vendor-expo-dev-client)",
      "Skill(vendor-callstack-upgrading-rn)",
      "Skill(token-pipeline)",
      "Skill(start-session)",
      "Skill(setup-ui-package)",
      "Skill(story)",
      "Skill(ui-track-b)",
      "Skill(vendor-expo-deployment)",
      "Skill(frontend-design)",
      "Skill(memory-notes)",
      "Skill(memory-tasks)",
      "Skill(memory-schema)",
      "Skill(memory-reflect)",
      "Skill(memory-defrag)",
      "Skill(memory-lifecycle)",
      "Skill(memory-metadata-search)",
      "Skill(memory-ingest)",
      "Skill(memory-research)",
      "Skill(memory-literary-analysis)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__basic-memory__write_note",
      "mcp__basic-memory__edit_note",
      "mcp__basic-memory__read_note",
      "mcp__basic-memory__view_note",
      "mcp__basic-memory__search_notes",
      "mcp__basic-memory__search",
      "mcp__basic-memory__fetch",
      "mcp__basic-memory__build_context",
      "mcp__basic-memory__canvas",
      "mcp__basic-memory__cloud_info",
      "mcp__basic-memory__create_memory_project",
      "mcp__basic-memory__delete_note",
      "mcp__basic-memory__delete_project",
      "mcp__basic-memory__list_directory",
      "mcp__basic-memory__list_memory_projects",
      "mcp__basic-memory__list_workspaces",
      "mcp__basic-memory__move_note",
      "mcp__basic-memory__read_content",
      "mcp__basic-memory__recent_activity",
      "mcp__basic-memory__release_notes",
      "mcp__ide__getDiagnostics"
    ]
  },
  "enabledMcpjsonServers": [
    "context7",
    "basic-memory"
  ],
  "deny": [
    "Bash(rm -rf *)",
    "Bash(git push *)"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Session démarrée\" with title \"Claude Code\"' && printf '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"initialUserMessage\":\"/start-session\"}}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'MANDATORY RESEARCH CHAIN — before ANY code edit: (1) Basic Memory: search_notes for related notes/fixes/decisions. (2) opensrc/: check if the lib source is already in opensrc/. If yes, read it. If no, fetch it with npx opensrc <package>. (3) Web search: if steps 1-2 gave no answer, search the web (WebSearch/WebFetch). NEVER rely on training knowledge alone for external lib APIs, config, or behavior. If you skipped any step, STOP and do it now.'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Commande Bash terminée\" with title \"Claude Code\"' && echo 'REMINDER: If this was a test run (pnpm test) that failed, analyze the error output before retrying. Do not blindly retry the same command.'"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-edit.sh"
          }
        ]
      },
      {
        "matcher": "mcp__basic-memory__write_note",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Note Basic Memory créée\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "review-.*",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Review lancée\" with title \"Claude Code — Review\"'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "review-.*",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Review terminée\" with title \"Claude Code — Review\"'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Compaction auto imminente — le contexte va être résumé\" with title \"Claude Code\" with sound name \"Submarine\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude a terminé\" with title \"Claude Code\"'"
          }
        ]
      }
    ]
  }
}
