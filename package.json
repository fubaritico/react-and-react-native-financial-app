{
  "name": "react-and-react-native-financial-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "------------ EXPO (managed) ------------": "",
    "expo:start": "pnpm --filter mobile-expo-financial-app start",
    "expo:start:clean": "pnpm --filter mobile-expo-financial-app start:clean",
    "expo:ios": "pnpm --filter mobile-expo-financial-app ios",
    "expo:ios:iphone": "pnpm --filter mobile-expo-financial-app ios:iphone",
    "expo:ios:ipad": "pnpm --filter mobile-expo-financial-app ios:ipad",
    "expo:android": "pnpm --filter mobile-expo-financial-app android",
    "expo:android:phone": "pnpm --filter mobile-expo-financial-app android:phone",
    "expo:android:tablet": "pnpm --filter mobile-expo-financial-app android:tablet",
    "expo:ios:device": "pnpm --filter mobile-expo-financial-app ios:build:device",
    "expo:android:device": "pnpm --filter mobile-expo-financial-app android:build:device",
    "expo:prebuild": "pnpm --filter mobile-expo-financial-app prebuild",
    "expo:rebuild:ios": "pnpm --filter mobile-expo-financial-app prebuild && pnpm --filter mobile-expo-financial-app ios",
    "expo:rebuild:android": "./scripts/rebuild-android.sh apps/mobile-expo",
    "expo:rebuild:android:phone": "./scripts/rebuild-android.sh apps/mobile-expo Small_Phone",
    "expo:rebuild:android:tablet": "./scripts/rebuild-android.sh apps/mobile-expo Medium_Tablet",
    "expo:fix": "pnpm --filter mobile-expo-financial-app expo:fix",
    "expo:check": "pnpm --filter mobile-expo-financial-app expo:check",
    "------------ MOBILE (bare RN CLI) ------": "",
    "mobile:start": "pnpm --filter mobile-financial-app start",
    "mobile:start:clean": "pnpm --filter mobile-financial-app start:clean",
    "mobile:ios": "pnpm --filter mobile-financial-app ios",
    "mobile:android": "pnpm --filter mobile-financial-app android",
    "mobile:ios:device": "pnpm --filter mobile-financial-app ios:device",
    "mobile:pods": "pnpm --filter mobile-financial-app pods",
    "mobile:rebuild:ios": "pnpm --filter mobile-financial-app rebuild:ios",
    "mobile:rebuild:android": "./scripts/rebuild-android.sh apps/mobile",
    "mobile:rebuild:android:phone": "./scripts/rebuild-android.sh apps/mobile Small_Phone",
    "mobile:rebuild:android:tablet": "./scripts/rebuild-android.sh apps/mobile Medium_Tablet",
    "------------ EJECTED (expo ejected) ----": "",
    "ejected:start": "pnpm --filter mobile-expo-ejected-financial-app start",
    "ejected:ios": "pnpm --filter mobile-expo-ejected-financial-app ios:build",
    "ejected:android": "pnpm --filter mobile-expo-ejected-financial-app android:build",
    "------------ WEB ----------------------": "",
    "web:dev": "pnpm --filter web-financial-app dev",
    "web:prod": "pnpm --filter web-financial-app build && node apps/web/build/server/index.js",
    "------------ API ----------------------": "",
    "api:dev": "pnpm --filter api-financial-app dev",
    "api:prod": "pnpm --filter api-financial-app build && pnpm --filter api-financial-app start",
    "api:generate-spec": "pnpm --filter api-financial-app generate:spec",
    "api:generate-client": "pnpm api:generate-spec && pnpm --filter @financial-app/http-client generate",
    "------------ TOOLING ------------------": "",
    "build": "turbo build",
    "dev": "turbo dev",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "lint:root": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo test",
    "storybook": "pnpm --filter storybook-financial-app storybook",
    "tokens": "pnpm --filter @financial-app/tokens build",
    "icons": "pnpm --filter @financial-app/icons generate",
    "------------ DATA ---------------------": "",
    "prisma:sync": "pnpm --filter @financial-app/prisma db:sync",
    "seed": "./scripts/seed-dev.sh",
    "------------ MAINTENANCE --------------": "",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules",
    "clean:build": "rm -rf packages/*/build packages/*/dist apps/*/dist",
    "reset": "./scripts/reset-project.sh",
    "postinstall": "chmod +x scripts/rebuild-android.sh scripts/reset-project.sh scripts/update-changelogs.sh scripts/seed-dev.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",

    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-native": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript-eslint": "catalog:",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/engines",
      "prisma"
    ]
  }
}
