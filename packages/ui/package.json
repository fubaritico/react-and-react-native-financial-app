{
  "name": "@financial-app/ui",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "default": "./src/index.web.ts"
    },
    "./web": "./src/index.web.ts",
    "./native": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "react-native": "./src/index.ts",
  "imports": {
    "#Lib/*": "./src/lib/*",
    "#Atoms": "./src/components/atoms/index.ts",
    "#Atoms/*": "./src/components/atoms/*",
    "#Molecules": "./src/components/molecules/index.ts",
    "#Molecules/*": "./src/components/molecules/*",
    "#Organisms": "./src/components/organisms/index.ts",
    "#Organisms/*": "./src/components/organisms/*",
    "#Templates": "./src/components/templates/index.ts",
    "#Templates/*": "./src/components/templates/*"
  },
  "private": true,
  "scripts": {
    "changelog": "conventional-changelog -p angular -r 0 --path . > CHANGELOG.md",
    "build": "tsc --noEmit",
    "lint": "eslint ./src",
    "type-check": "tsc --noEmit",
    "test": "echo 'no tests yet'"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:"
  },
  "dependencies": {
    "@financial-app/icons": "workspace:^",
    "@financial-app/tailwind-config": "workspace:^",
    "@financial-app/tokens": "workspace:^",
    "@fontsource-variable/public-sans": "^5.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "@tanstack/react-table": "catalog:",
    "twrnc": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "~19.1.0",
    "conventional-changelog": "catalog:",
    "react-dom": "catalog:",
    "react-native-svg": "catalog:",
    "typescript": "catalog:"
  }
}
