{
  "name": "@financial-app/http-client",
  "version": "1.0.0",
  "private": true,
  "description": "Financial App API client generated with HeyAPI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "generate": "openapi-ts && node scripts/add-ts-nocheck.js && eslint src --fix",
    "build": "pnpm clean && pnpm generate && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@hey-api/openapi-ts": "^0.92.3",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
